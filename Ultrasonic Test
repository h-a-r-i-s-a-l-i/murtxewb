void setup() {​

 pinMode(2, OUTPUT);​

 pinMode(4, INPUT);​

 Serial.begin(9600);​

}​

void loop() {​

 digitalWrite(2, LOW);​

 delayMicroseconds(4);​

 digitalWrite(2, HIGH);​

 delayMicroseconds(10);​

 digitalWrite(2, LOW);​

